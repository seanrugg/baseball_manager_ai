   "source": [
    "# Baseball Data Exploration\n",
    "\n",
    "## Overview\n",
    "This notebook explores baseball data from various sources to understand patterns, distributions, and relationships in the data.\n",
    "\n",
    "## Objectives\n",
    "- Load and clean baseball data from multiple sources\n",
    "- Explore player statistics and distributions\n",
    "- Analyze team performance metrics\n",
    "- Visualize game outcomes and trends\n",
    "- Identify data quality issues\n",
    "\n",
    "## Data Sources\n",
    "- MLB Stats API\n",
    "- Baseball Reference\n",
    "- Retrosheet\n",
    "- Custom game logs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set style\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "print(\"Libraries imported successfully\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load data\n",
    "def load_baseball_data():\n",
    "    \"\"\"Load sample baseball datasets.\"\"\"\n",
    "    data_dir = Path('../data')\n",
    "    \n",
    "    # Sample data - in practice, this would load from actual sources\n",
    "    players_data = pd.DataFrame({\n",
    "        'player_id': range(1, 101),\n",
    "        'name': [f'Player_{i}' for i in range(1, 101)],\n",
    "        'team': np.random.choice(['NYY', 'BOS', 'LAD', 'SFG', 'CHC'], 100),\n",
    "        'position': np.random.choice(['P', 'C', '1B', '2B', '3B', 'SS', 'LF', 'CF', 'RF'], 100),\n",
    "        'age': np.random.randint(20, 40, 100),\n",
    "        'batting_avg': np.random.normal(0.250, 0.030, 100),\n",
    "        'ops': np.random.normal(0.750, 0.100, 100),\n",
    "        'home_runs': np.random.poisson(15, 100),\n",
    "        'rbi': np.random.poisson(60, 100),\n",
    "        'war': np.random.normal(2.0, 1.5, 100)\n",
    "    })\n",
    "    \n",
    "    # Ensure realistic ranges\n",
    "    players_data['batting_avg'] = players_data['batting_avg'].clip(0.150, 0.350)\n",
    "    players_data['ops'] = players_data['ops'].clip(0.500, 1.100)\n",
    "    players_data['war'] = players_data['war'].clip(-1.0, 6.0)\n",
    "    \n",
    "    # Game data\n",
    "    game_data = pd.DataFrame({\n",
    "        'game_id': range(1, 501),\n",
    "        'date': pd.date_range('2023-03-30', periods=500, freq='D'),\n",
    "        'home_team': np.random.choice(['NYY', 'BOS', 'LAD', 'SFG', 'CHC', 'STL', 'ATL', 'HOU'], 500),\n",
    "        'away_team': np.random.choice(['NYY', 'BOS', 'LAD', 'SFG', 'CHC', 'STL', 'ATL', 'HOU'], 500),\n",
    "        'home_score': np.random.poisson(4.5, 500),\n",
    "        'away_score': np.random.poisson(4.2, 500),\n",
    "        'stadium': np.random.choice(['Yankee Stadium', 'Fenway Park', 'Dodger Stadium', 'Wrigley Field'], 500),\n",
    "        'attendance': np.random.randint(20000, 50000, 500)\n",
    "    })\n",
    "    \n",
    "    # Remove games where home and away are the same team\n",
    "    game_data = game_data[game_data['home_team'] != game_data['away_team']]\n",
    "    \n",
    "    return players_data, game_data\n",
    "\n",
    "players_df, games_df = load_baseball_data()\n",
    "\n",
    "print(f\"Players data: {players_df.shape}\")\n",
    "print(f\"Games data: {games_df.shape}\")\n",
    "players_df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic data info\n",
    "print(\"=== Players Data Info ===\")\n",
    "players_df.info()\n",
    "print(\"\\n=== Games Data Info ===\")\n",
    "games_df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Descriptive statistics\n",
    "print(\"=== Players Statistics ===\")\n",
    "players_df.describe()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Distribution of key metrics\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
    "\n",
    "metrics = ['batting_avg', 'ops', 'home_runs', 'rbi', 'war', 'age']\n",
    "for i, metric in enumerate(metrics):\n",
    "    ax = axes[i//3, i%3]\n",
    "    players_df[metric].hist(bins=20, ax=ax, alpha=0.7)\n",
    "    ax.set_title(f'Distribution of {metric.replace(\"_\", \" \").title()}')\n",
    "    ax.set_xlabel(metric.replace('_', ' ').title())\n",
    "    ax.set_ylabel('Frequency')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Position analysis\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "\n",
    "# Batting average by position\n",
    "position_batting = players_df.groupby('position')['batting_avg'].mean().sort_values()\n",
    "position_batting.plot(kind='bar', ax=axes[0,0], color='skyblue')\n",
    "axes[0,0].set_title('Average Batting Average by Position')\n",
    "axes[0,0].set_ylabel('Batting Average')\n",
    "\n",
    "# OPS by position\n",
    "position_ops = players_df.groupby('position')['ops'].mean().sort_values()\n",
    "position_ops.plot(kind='bar', ax=axes[0,1], color='lightcoral')\n",
    "axes[0,1].set_title('Average OPS by Position')\n",
    "axes[0,1].set_ylabel('OPS')\n",
    "\n",
    "# Home runs by position\n",
    "position_hr = players_df.groupby('position')['home_runs'].mean().sort_values()\n",
    "position_hr.plot(kind='bar', ax=axes[1,0], color='lightgreen')\n",
    "axes[1,0].set_title('Average Home Runs by Position')\n",
    "axes[1,0].set_ylabel('Home Runs')\n",
    "\n",
    "# WAR by position\n",
    "position_war = players_df.groupby('position')['war'].mean().sort_values()\n",
    "position_war.plot(kind='bar', ax=axes[1,1], color='gold')\n",
    "axes[1,1].set_title('Average WAR by Position')\n",
    "axes[1,1].set_ylabel('WAR')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Team performance analysis\n",
    "print(\"=== Team Performance Analysis ===\")\n",
    "\n",
    "# Home vs Away performance\n",
    "home_wins = len(games_df[games_df['home_score'] > games_df['away_score']])\n",
    "away_wins = len(games_df[games_df['away_score'] > games_df['home_score']])\n",
    "ties = len(games_df[games_df['home_score'] == games_df['away_score']])\n",
    "\n",
    "print(f\"Home wins: {home_wins} ({home_wins/len(games_df)*100:.1f}%)\")\n",
    "print(f\"Away wins: {away_wins} ({away_wins/len(games_df)*100:.1f}%)\")\n",
    "print(f\"Ties: {ties} ({ties/len(games_df)*100:.1f}%)\")\n",
    "\n",
    "# Run distribution\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "\n",
    "games_df['home_score'].hist(bins=20, ax=axes[0], alpha=0.7, color='blue')\n",
    "axes[0].set_title('Distribution of Home Team Runs')\n",
    "axes[0].set_xlabel('Runs')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "\n",
    "games_df['away_score'].hist(bins=20, ax=axes[1], alpha=0.7, color='red')\n",
    "axes[1].set_title('Distribution of Away Team Runs')\n",
    "axes[1].set_xlabel('Runs')\n",
    "axes[1].set_ylabel('Frequency')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation analysis\n",
    "numeric_columns = ['batting_avg', 'ops', 'home_runs', 'rbi', 'war', 'age']\n",
    "correlation_matrix = players_df[numeric_columns].corr()\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', center=0,\n",
    "            square=True, linewidths=0.5)\n",
    "plt.title('Correlation Matrix of Player Metrics')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Advanced visualizations\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n",
    "\n",
    "# Scatter plot: OPS vs WAR\n",
    "axes[0,0].scatter(players_df['ops'], players_df['war'], alpha=0.6)\n",
    "axes[0,0].set_xlabel('OPS')\n",
    "axes[0,0].set_ylabel('WAR')\n",
    "axes[0,0].set_title('OPS vs WAR')\n",
    "\n",
    "# Box plot: WAR by position\n",
    "players_df.boxplot(column='war', by='position', ax=axes[0,1])\n",
    "axes[0,1].set_title('WAR Distribution by Position')\n",
    "axes[0,1].set_ylabel('WAR')\n",
    "\n",
    "# Run differential analysis\n",
    "games_df['run_differential'] = games_df['home_score'] - games_df['away_score']\n",
    "games_df['run_differential'].hist(bins=30, ax=axes[1,0], alpha=0.7)\n",
    "axes[1,0].axvline(x=0, color='red', linestyle='--')\n",
    "axes[1,0].set_title('Distribution of Run Differential')\n",
    "axes[1,0].set_xlabel('Home Runs - Away Runs')\n",
    "axes[1,0].set_ylabel('Frequency')\n",
    "\n",
    "# Attendance vs runs\n",
    "games_df['total_runs'] = games_df['home_score'] + games_df['away_score']\n",
    "axes[1,1].scatter(games_df['attendance'], games_df['total_runs'], alpha=0.5)\n",
    "axes[1,1].set_xlabel('Attendance')\n",
    "axes[1,1].set_ylabel('Total Runs')\n",
    "axes[1,1].set_title('Attendance vs Total Runs')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data quality checks\n",
    "print(\"=== Data Quality Report ===\")\n",
    "\n",
    "def check_data_quality(df, df_name):\n",
    "    print(f\"\\n{df_name}:\")\n",
    "    print(f\"  Total records: {len(df)}\")\n",
    "    print(f\"  Missing values:\")\n",
    "    for col in df.columns:\n",
    "        missing = df[col].isnull().sum()\n",
    "        if missing > 0:\n",
    "            print(f\"    {col}: {missing} ({missing/len(df)*100:.1f}%)\")\n",
    "    \n",
    "    print(f\"  Duplicate records: {df.duplicated().sum()}\")\n",
    "    \n",
    "    # Check for unrealistic values\n",
    "    if 'batting_avg' in df.columns:\n",
    "        unrealistic_ba = df[(df['batting_avg'] < 0.1) | (df['batting_avg'] > 0.4)]\n",
    "        print(f\"  Unrealistic batting averages: {len(unrealistic_ba)}\")\n",
    "\n",
    "check_data_quality(players_df, \"Players Data\")\n",
    "check_data_quality(games_df, \"Games Data\")"
   ]
  },
  {
