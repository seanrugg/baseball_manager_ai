# Environment Variables for Baseball Manager AI
# Copy this file to .env and fill in your values. Do NOT commit the real .env.

# Database Configuration (PostgreSQL, used by docker-compose)
# DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/<dbname>
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost
DB_PORT=5432

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
ENVIRONMENT=development

# Model Configuration
MODEL_DIR=models
MODEL_VERSION=latest

# Data Configuration
DATA_DIR=data
CACHE_DIR=cache

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
SQL_ECHO=false

# External APIs (Optional)
MLB_STATS_API_KEY=
BASEBALL_SAVANT_API_KEY=
