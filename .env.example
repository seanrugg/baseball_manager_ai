# Environment Variables for Baseball Manager AI
# Copy this file to .env and fill in your values

# Database Configuration (MariaDB)
DATABASE_URL=mysql+pymysql://baseball_user:baseball_password@localhost:3306/baseball_db
DB_USER=baseball_user
DB_PASSWORD=baseball_password
DB_NAME=baseball_db
DB_HOST=localhost
DB_PORT=3306

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
ENVIRONMENT=development

# Model Configuration
MODEL_DIR=models
MODEL_VERSION=latest

# Data Configuration
DATA_DIR=data
CACHE_DIR=cache

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
SQL_ECHO=false

# External APIs (Optional)
MLB_STATS_API_KEY=
BASEBALL_SAVANT_API_KEY=
