# Environment Variables for Baseball Manager AI
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Model Configuration
MODEL_DIR=models
MODEL_VERSION=latest

# Data Configuration
DATA_DIR=data
CACHE_DIR=cache

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# External APIs (Optional)
MLB_STATS_API_KEY=
BASEBALL_SAVANT_API_KEY=
